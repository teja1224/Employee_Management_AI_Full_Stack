{
  "name": "Employee_App_Bot",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@google/genai": "^2.30.0",
    "@sap/cds": "^10",
    "dotenv": "^18.0.8",
    "groq-sdk": "^1.6.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employee_ui": "cds watch --open employeebot.employeeui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy Employee_App_Bot --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
