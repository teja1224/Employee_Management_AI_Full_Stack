<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog id="addEmployeeDialog" title="Add New Employee" stretch="false" contentWidth="600px" contentHeight="auto">
        <content>
            <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <form:content>
                <Label text="Name" required="true"/>
                <Input value="{newEmployee>/name}" placeholder="Enter employee name" />
                
                <Label text="Email" required="true"/>
                <Input value="{newEmployee>/email}" placeholder="Enter email address" />
                
                <Label text="Role" required="true"/>
                <Input value="{newEmployee>/role}" placeholder="Enter job role" />

                <Label text="Salary"/>
                <Input value="{newEmployee>/salary}" type="Number" placeholder="Enter salary LPA"/>

                <!-- Department Dropdown: Bound directly to the backend OData V4 model (/Departments) -->
                <Label text="Department"/>
                <Select items="{/Departments}" selectedKey="{newEmployee>/department_ID}" >
                    <core:Item key="{ID}" text="{name} ({code})"/>
                </Select>

                <!-- Projects Multi-Select: Bound directly to the backend OData V4 model (/Projects) -->
                <Label text="Assigned Projects"/>
                <MultiComboBox 
                    items="{/Projects}" 
                    selectedKeys="{newEmployee>/selectedProjectIDs}"
                    placeholder="Select projects">
                    <core:Item key="{ID}" text="{title}"/>
                </MultiComboBox>
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press=".onSaveEmployee"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>